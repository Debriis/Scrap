PORT=4000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Relative to the directory from which the server is started. Default: backend/data/inquiries.sqlite
DB_PATH=./data/inquiries.sqlite
# Set only behind a known reverse proxy; never enable blanket trust.
# TRUST_PROXY_HOPS=1
# Optional SMTP; missing configuration does not prevent storage.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFICATION_EMAIL=
